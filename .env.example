# ---------------------------------------------------------------
# Vshare configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------

# Storage backend: "cloudinary" (default) or "mock" (local folder, offline).
STORAGE=cloudinary

# Cloudinary credentials (Dashboard -> Settings -> API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder prefix for stored objects.
# CLOUDINARY_FOLDER=vshare

# 32-byte master key used to wrap every file key: 64 hex characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty, a key is generated on first start and saved to DATA_DIR/.master.key.
# LOSING THIS KEY MAKES EVERY STORED FILE UNREADABLE.
MASTER_KEY=

# HTTP port (default 3000).
PORT=3000

# Where the SQLite DB and the generated .master.key live (default ./data).
# DATA_DIR=./data

# Upload limit in bytes. Default: 10 MB with Cloudinary (free plans cap raw
# uploads at 10 MB), 100 MB with STORAGE=mock.
# MAX_FILE_SIZE_BYTES=10485760

# Set to 1 when running behind ONE reverse proxy (Caddy/nginx) so rate limiting
# sees the real client IP.
# TRUST_PROXY=1

# debug | info | warn | error | silent
# LOG_LEVEL=info

# NODE_ENV=production
